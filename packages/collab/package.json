  "dependencies": {
    "@nseaprotector/coelho-core": "workspace:*",
    "@nseaprotector/coelho-prosemirror": "workspace:*",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7"
