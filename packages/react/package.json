  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@coelho/core": "workspace:*",
    "@coelho/prosemirror": "workspace:*",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react-dom": "19.1.6"
  }
}
