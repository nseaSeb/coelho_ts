{
  "name": "@nseaprotector/coelho-prosemirror",
  "version": "0.3.0",
  "description": "A ProseMirror rich text editor on a schema you own: anchored comments, @mentions and / commands, Markdown import and paste, HTML import that runs nothing. Framework-free, for React, Vue, Angular or plain JS.",
  "keywords": [
    "prosemirror",
    "rich-text",
    "richtext",
    "editor",
    "wysiwyg",
    "wysiwyg-editor",
    "text-editor",
    "comments",
    "mentions",
    "slash-commands",
    "markdown",
    "paste",
    "vue",
    "angular",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sébastien Portrait <nseaprotector@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nseaSeb/coelho_ts.git",
    "directory": "packages/prosemirror"
  },
  "homepage": "https://github.com/nseaSeb/coelho_ts/tree/main/packages/prosemirror#readme",
  "bugs": {
    "url": "https://github.com/nseaSeb/coelho_ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@nseaprotector/coelho-core": "workspace:*",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2"
  }
}
