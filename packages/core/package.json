{
  "name": "@nseaprotector/coelho-core",
  "version": "0.3.0",
  "description": "Structured rich text you own: a schema, strict validation, a canonical JSON form and its hash, sanitize, safe HTML, Markdown and plain text. No editor, no DOM, no dependency.",
  "keywords": [
    "rich-text",
    "richtext",
    "prosemirror",
    "json",
    "schema",
    "validation",
    "sanitize",
    "sanitizer",
    "html",
    "markdown",
    "commonmark",
    "xss",
    "canonical",
    "hash",
    "comments",
    "anchors",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sébastien Portrait <nseaprotector@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nseaSeb/coelho_ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nseaSeb/coelho_ts/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/nseaSeb/coelho_ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  }
}
